generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  modelRuns ModelRun[]
  preds     Prediction[]
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum ModelRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ModelRun {
  id           String         @id @default(cuid())
  orgId        String
  org          Organization   @relation(fields: [orgId], references: [id])
  status       String         @default("PENDING")
  config       String
  metrics      String?
  artifactsDir String
  plots        String?
  gradePoints  String?
  bestModel    String?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?
  supersededAt DateTime?

  @@index([orgId, createdAt(sort: Desc)])
}

model Prediction {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  studentId  String
  inputPath  String
  results    String
  outFile    String
  summary    String?
  createdAt  DateTime      @default(now())

  @@index([orgId, createdAt(sort: Desc)])
}
